# Required for app.py
# Rename this file to .env. Only .env is git ignored. NEVER commit real tokens

# IMPORTANT!!!: Rename this file to .env BEFORE committing your secrets

# Bot User OAuth Token (starts with xoxb-)
# api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=

# App-Level Token with the connections:write scope (starts with xapp-)
# api.slack.com/apps -> your app -> Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=

# Elasticsearch endpoint URL, including http:// or https:// and no trailing slash. 
ELASTICSEARCH_URL=

# API key (only needs READ access scoped to logs-* and metrics-*)
# Can be created in Kibana -> Stack Management -> API Keys
ELASTICSEARCH_API_KEY=
