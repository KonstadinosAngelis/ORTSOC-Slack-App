# Required for app.py
# Rename this file to .env. Only .env is git ignored. NEVER commit real tokens

# IMPORTANT!!!: Rename this file to .env BEFORE comitting your secrets

# Bot User OAuth Token (starts with xoxb-)
# api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token with the connections:write scope (starts with xapp-)
# api.slack.com/apps -> your app -> Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token
