# Required for app.py
# NOTE!!! .env is git-ignored. NEVER commit real tokens. Only this example file is committed. Remove .example from the file name before committing!

# Bot User OAuth Token (starts with xoxb-)
# api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token with the connections:write scope (starts with xapp-)
# api.slack.com/apps -> your app -> Basic Information -> App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token
