{
    "display_information": {
        "name": "ORTSOC Log Source Alerts (local)",
        "description": "Group 1 Log Source Health Alert Bot",
        "background_color": "#CC005F"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false,
            "agent_tasks_enabled": true
        },
        "bot_user": {
            "display_name": "ORTSOC Log Source Alerts (local)",
            "always_online": true
        },
        "shortcuts": [
            {
                "name": "Run sample shortcut",
                "type": "global",
                "callback_id": "sample_shortcut_id",
                "description": "Runs a sample shortcut"
            }
        ],
        "slash_commands": [
            {
                "command": "/es_health",
                "description": "Checks cluster health",
                "should_escape": false
            },
	    {
		"command": "/es_event_count",
		"description": "Returns the total of logs ingested in the last hour.",
		"should_escape": false
	    },	    
            {
                "command": "/es_lastseen",
                "description": "Returns the timestamp, time ingested, agent name, and average logs per minute over the last hour for Zeek and Suricata.",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "user": [
                "im:read",
                "im:history",
                "mpim:history"
            ],
            "bot": [
                "channels:history",
                "chat:write",
                "commands",
                "im:write",
                "im:write.topic",
                "im:read",
                "incoming-webhook"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "user_events": [
                "im_close",
                "im_created",
                "im_open",
                "message.im"
            ],
            "bot_events": [
                "app_home_opened",
                "message.channels"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": true,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
